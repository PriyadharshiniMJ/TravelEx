TAVILY_API_KEY=
LLM_MODEL=openai:<model-name>
# LLM_MODEL_FAST=openai:<cheaper-model>
# The evaluation's LLM judges: a different model from the agent's, so it never grades its own work
# LLM_MODEL_JUDGE=openai:gpt-5.2
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# LangSmith tracing: every node, LLM call and tool call is sent to this project.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travelex-dev
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com   # APAC accounts; EU: https://eu.api.smith.langchain.com
# LANGSMITH_HIDE_INPUTS=true    # redact passports, ages and diets from traces

# Search cache: pages older than this many days are fetched again (default 7). TRAVELEX_REFRESH=1 ignores the cache.
# TRAVELEX_SEARCH_TTL_DAYS=7
# TRAVELEX_REFRESH=1

# Run-wide limits, shared by every research branch of one trip (research stops gracefully when one is reached)
# TRAVELEX_MAX_SEARCHES=150
# TRAVELEX_MAX_TOKENS=3000000
# TRAVELEX_MAX_SECONDS=1200
# TRAVELEX_MAX_CONCURRENCY=8
